<?xml version="1.0" encoding="utf-8"?>
<!--
  kl 分组卡片 v3 —— 按用户排版规格重做：

  订阅分组（四行）：
      名称
      流量信息（已用 X / 剩余 Y）
      过期时间（到期·2027-3-11）
      N 个配置          [更新订阅] ← 按钮在第四行右边

  本地分组（三行）：
      名称
      创建·2026-5-5
      N 个配置

  · 去掉了订阅卡「N 个配置 | 更新于 M-d」里的更新时间字样和 SIP008 用户名行
  · 顶部仍是 ☰ 拖拽 / ✏️ 编辑 / ⋮ 更多；左滑删除面板 = 48dp 方块，位置正好盖住 ✏️
  · 删除面板在 MaterialCardView 框内右缘，收起时被推出卡片由卡片裁剪
-->
<io.nekohasekai.sagernet.widget.KlSwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kl_swipe_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/content"
        style="@style/Widget.SagerNet.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/subscription_update_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?colorPrimary" />

            <!-- 第一行：名称 + ☰ ✏️ ⋮ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="15dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/group_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold"
                        tools:text="@string/group_name" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/drag_handle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/kl_drag_sort"
                    android:focusable="true"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_kl_drag_handle" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:focusable="true"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_image_edit" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/container"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_baseline_more_vert_24" />

            </LinearLayout>

            <!-- 中段信息行：订阅 = 流量/到期；本地 = 创建时间 -->
            <TextView
                android:id="@+id/group_created"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:text="创建·2026-9-6" />

            <TextView
                android:id="@+id/group_traffic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="8dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:text="已用 70.7GB / 剩余 149GB" />

            <!-- kl 新增：过期时间独立一行（SIP008 expiryDate / Raw userinfo expire=） -->
            <TextView
                android:id="@+id/group_expire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="6dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:text="到期·2027-3-11" />

            <!-- 第四行：N 个配置（左） + 更新订阅（右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/group_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="1 个配置" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/group_update"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/kl_update_sub"
                    android:textColor="?android:textColorSecondary" />
            </LinearLayout>

        </LinearLayout>

        <!-- 左滑露出的删除按钮：48dp 方块，位置正好盖住 ✏️ 编辑键
             （⋮ 占最右 48dp，面板 marginEnd=48 → 恰好落在编辑键槽位上） -->
        <LinearLayout
            android:id="@+id/kl_swipe_reveal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="48dp"
            android:background="@drawable/kl_delete_reveal_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/delete"
                app:srcCompat="@drawable/ic_baseline_delete_24"
                app:tint="@color/kl_delete_fg" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</io.nekohasekai.sagernet.widget.KlSwipeRevealLayout>
