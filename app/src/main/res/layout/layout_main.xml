<?xml version="1.0" encoding="utf-8"?>
<!--
  kl 主布局：
  · 删掉上游 DrawerLayout + 两套 NavigationView（☰ 侧边抽屉整个下线）
  · 删掉 ServiceButton(FAB) + fabProgress + StatsBar(BottomAppBar)
  · 换成 HTML 原型的 dock（右下角圆角方块，运行时向左展开出速率/延迟）
  · 底部四按钮：配置 / 分组 / 分流 / 设置
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/kl_bottom_nav_height" />

    <!-- 原型 .dock-row：右对齐、贴住底栏上方，padding-right 与卡片右边缘对齐 -->
    <io.nekohasekai.sagernet.widget.KlDock
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="@dimen/kl_dock_margin_bottom" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl_bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="?attr/colorPrimary"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/kl_bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
