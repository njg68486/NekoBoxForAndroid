<?xml version="1.0" encoding="utf-8"?>
<!--
  kl 链式代理/服务器选择 —— 第二阶段的双列节点迷你卡：
  · 上部两行：节点名称（最多 2 行）
  · 左下角：协议
  · 没有任何 ⋮/编辑/分享按钮 —— 这里只是「选一个配置」
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mini_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?android:attr/colorBackground"
    app:rippleColor="@color/kl_dock"
    app:strokeColor="@color/kl_pick_stroke"
    app:strokeWidth="1dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/mini_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="2"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            tools:text="🇭🇰 香港 01 · IEPL 专线长名称测试" />

        <TextView
            android:id="@+id/mini_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/kl_dock"
            android:textSize="12sp"
            tools:text="Trojan" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
