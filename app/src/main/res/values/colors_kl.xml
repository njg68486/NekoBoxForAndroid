<?xml version="1.0" encoding="utf-8"?>
<!--
  kl 魔改配色。注意：dock 本体（背景 + 前景）不再从这里取色 ——
  背景跟随主题 ?colorPrimary（KlDock 用 backgroundTintList 染色），
  前景与上游 FAB/StatsBar 一致固定白色。kl_dock 只作选择页强调色用。
-->
<resources>
    <color name="kl_dock">#0BA8E5</color>

    <!-- 左滑删除面板（照用户给的样式图取色） -->
    <color name="kl_delete_bg">#4A3A3E</color>
    <color name="kl_delete_stroke">#6E555A</color>
    <color name="kl_delete_fg">#F2A6B0</color>

    <!-- 选择页迷你卡描边（选中态描边换 kl_dock） -->
    <color name="kl_pick_stroke">#3A4650</color>
    <!-- 底栏（原型 selected/selected-border/bg-bottom 变量） -->
    <color name="kl_nav_pill">#214A66</color>
    <color name="kl_nav_active">#90CDFC</color>
    <color name="kl_nav_inactive">#FFFFFF</color>
</resources>
