<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡片背景(顶部圆角)，上下左右留边距形成悬浮卡片 -->
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
            <solid android:color="@color/pref_card_background" />
        </shape>
    </item>
    <!-- 底部分割线(与卡片同宽，不伸出卡片外) -->
    <item
        android:left="8dp"
        android:right="8dp"
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pref_card_divider" />
        </shape>
    </item>
</layer-list>
