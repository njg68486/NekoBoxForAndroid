<?xml version="1.0" encoding="utf-8"?>
<!--
  左滑露出的删除面板底：暗红调 + 细描边 + 圆角，与截图一致。
  只在右侧收圆角（左边是从卡片内部长出来的），用 topRight/bottomRight。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kl_delete_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/kl_delete_stroke" />
    <corners android:radius="12dp" />
</shape>
